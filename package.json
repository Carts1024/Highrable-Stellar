{
  "name": "highrable-stellar",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "contracts:build": "cd contracts && stellar contract build",
    "contracts:deploy:testnet": "bash scripts/deploy-testnet.sh",
    "contracts:verify:testnet": "bash scripts/verify-testnet.sh",
    "dev": "turbo run dev",
    "lint:fix": "turbo run lint:fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "turbo": "^2.8.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@8.6.0"
}
