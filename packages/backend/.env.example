STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
REPUTATION_CONTRACT_ID=CREPLACE_WITH_DEPLOYED_REPUTATION_CONTRACT_ID
ESCROW_CONTRACT_ID=CREPLACE_WITH_DEPLOYED_ESCROW_CONTRACT_ID
REGISTRY_CONTRACT_ID=CREPLACE_WITH_DEPLOYED_REGISTRY_CONTRACT_ID
STELLAR_READ_SOURCE_ACCOUNT=GREPLACE_WITH_ANY_FUNDED_TESTNET_STELLAR_ADDRESS
# Use the same high-entropy value as the web server's HIGHRABLE_AUTH_SERVICE_SECRET.
HIGHRABLE_AUTH_SERVICE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
HIGHRABLE_ADMIN_WALLET_ADDRESS=GREPLACE_WITH_PLATFORM_ADMIN_WALLET
HIGHRABLE_ADMIN_CONVEX_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
HIGHRABLE_WAITLIST_EMAIL_FROM=Highrable <waitlist@highrable.work>
HIGHRABLE_APP_URL=https://highrable.work

# Velo Gas Station is consumed by the Next.js Node route, not Convex. Keep
# these values in the web server environment as well when enabling the flow.
VELO_GAS_API_KEY=tg_test_replace_with_32_hex_characters
VELO_GAS_ENV=testnet
VELO_GAS_BASE_URL=https://www.velo-build.dev

# Configure these on the Convex deployment as well as the web release flags.
NEWSFEED_ENABLED=false
NEWSFEED_TEXT_ENABLED=false
NEWSFEED_PHOTOS_ENABLED=false
# Exact comma-separated browser origins; no wildcard.
NEWSFEED_APP_ORIGINS=http://localhost:3000
NEWSFEED_MODERATOR_WALLETS=
