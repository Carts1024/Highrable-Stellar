# Highrable web environment template.
# Do not put real private keys or API keys in NEXT_PUBLIC_* variables.

# -----------------------------------------------------------------------------
# Required public Stellar network config
# -----------------------------------------------------------------------------
# Required. Expected values: local, testnet, mainnet, public.
# Note: public is accepted as a mainnet alias.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Required. Expected values:
# - Testnet: Test SDF Network ; September 2015
# - Mainnet: Public Global Stellar Network ; September 2015
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Required. Expected value: Stellar/Soroban RPC URL for the selected network.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Required for external-wallet balances and XLM -> USDC Path Payment top-up.
# Expected value: Horizon URL for the selected network.
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Required. Expected value: Convex deployment URL.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# -----------------------------------------------------------------------------
# Required public app/passkey config
# -----------------------------------------------------------------------------
# Required. Testnet/local may use localhost. Mainnet must be production HTTPS.
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000

# Required for passkeys. Expected value: readable relying-party name.
NEXT_PUBLIC_PASSKEY_RP_NAME=Highrable

# Required for passkey smart-account features.
# Expected value: 64-character lowercase/uppercase hex WASM hash.
NEXT_PUBLIC_SMART_ACCOUNT_WASM_HASH=

# Required for passkey smart-account features.
# Expected value: Stellar contract ID starting with C.
NEXT_PUBLIC_WEBAUTHN_VERIFIER_CONTRACT_ID=

# -----------------------------------------------------------------------------
# Required public Highrable contract config
# -----------------------------------------------------------------------------
# Required. Expected value: Stellar contract ID starting with C.
NEXT_PUBLIC_ESCROW_CONTRACT_ID=CREPLACE_WITH_DEPLOYED_ESCROW_CONTRACT_ID

# Required for reputation sync/display. Expected value: Stellar contract ID starting with C.
NEXT_PUBLIC_REPUTATION_CONTRACT_ID=CREPLACE_WITH_DEPLOYED_REPUTATION_CONTRACT_ID

# Required for USDC/stablecoin escrow. Expected value: Stellar token contract ID starting with C.
NEXT_PUBLIC_STABLECOIN_TOKEN_CONTRACT_ID=

# Optional unless XLM escrow is enabled. Expected value: native XLM SAC contract ID starting with C.
NEXT_PUBLIC_NATIVE_XLM_TOKEN_CONTRACT_ID=

# -----------------------------------------------------------------------------
# Required public classic USDC / Path Payment config
# -----------------------------------------------------------------------------
# Required for Phase 24 external-wallet XLM -> USDC top-up.
# Expected value: classic Stellar asset code, usually USDC.
NEXT_PUBLIC_USDC_ASSET_CODE=USDC

# Required for Phase 24 external-wallet XLM -> USDC top-up.
# Expected value: classic Stellar issuer account starting with G.
NEXT_PUBLIC_USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Backward-compatible stablecoin asset fields.
# Optional when NEXT_PUBLIC_USDC_ASSET_CODE / NEXT_PUBLIC_USDC_ASSET_ISSUER are set.
NEXT_PUBLIC_STABLECOIN_ASSET_CODE=USDC
NEXT_PUBLIC_STABLECOIN_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional display metadata. Expected decimals value: integer from 0 to 18.
NEXT_PUBLIC_STABLECOIN_SYMBOL=Mock USDC
NEXT_PUBLIC_STABLECOIN_DECIMALS=7

# -----------------------------------------------------------------------------
# Optional public smart-account deployment metadata
# -----------------------------------------------------------------------------
# Optional. Expected value: Stellar contract ID starting with C.
NEXT_PUBLIC_SMART_ACCOUNT_FACTORY_CONTRACT_ID=

# Optional. Expected values: deployment label/version/source repository metadata.
NEXT_PUBLIC_SMART_ACCOUNT_DEPLOYMENT_LABEL=highrable-smart-accounts-v1
NEXT_PUBLIC_SMART_ACCOUNT_DEPLOYMENT_VERSION=1.0.0
NEXT_PUBLIC_SMART_ACCOUNT_SOURCE_REPO=

# Optional but recommended for mainnet readiness.
# Expected value: 64-character lowercase/uppercase SHA-256 hex digest.
NEXT_PUBLIC_SMART_ACCOUNT_WASM_SHA256=
NEXT_PUBLIC_WEBAUTHN_VERIFIER_WASM_SHA256=

# -----------------------------------------------------------------------------
# Public relayer/channel selection
# -----------------------------------------------------------------------------
# Required for readiness display. Expected values:
# - none
# - custom
# - openzeppelin_channels
# - sdk_source_account
# Do not use launchtube.
NEXT_PUBLIC_SMART_ACCOUNT_RELAYER_KIND=none

# Optional unless relayer kind is custom or openzeppelin_channels.
# Expected value: HTTPS URL on mainnet; localhost only for development.
NEXT_PUBLIC_SMART_ACCOUNT_RELAYER_URL=

# -----------------------------------------------------------------------------
# Optional public wallet config
# -----------------------------------------------------------------------------
# Required in production if WalletConnect is enabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=REPLACE_WITH_YOUR_WALLETCONNECT_PROJECT_ID

# Usually supplied by the runtime. Expected values: development, production, test.
NODE_ENV=development

# -----------------------------------------------------------------------------
# Server-only / private env vars
# -----------------------------------------------------------------------------
# Optional but recommended for server wallet auth. Do not expose in NEXT_PUBLIC_*.
WALLET_SESSION_SECRET=

# Required for admin-only dashboard and dispute management.
# Expected value: Stellar public key for the single platform admin wallet (starts with G).
HIGHRABLE_ADMIN_WALLET_ADDRESS=

# Required for server-side admin API routes calling admin Convex functions.
# Expected value: high-entropy shared secret. Never expose to browser code.
HIGHRABLE_ADMIN_CONVEX_SECRET=

# Required only for a custom self-hosted smart-account relayer.
# Expected value: secret key. Never expose to the browser.
SMART_ACCOUNT_RELAYER_PRIVATE_KEY=

# Optional or required by relayer deployment. Expected value: Stellar account ID starting with G.
SMART_ACCOUNT_RELAYER_PUBLIC_KEY=

# Required only when using NEXT_PUBLIC_SMART_ACCOUNT_RELAYER_KIND=openzeppelin_channels.
# Expected value: OpenZeppelin Channels API key. Never expose to the browser.
SMART_ACCOUNT_CHANNELS_API_KEY=

# Required for production relayer safety.
# Expected value: comma-separated Stellar contract IDs starting with C.
SMART_ACCOUNT_ALLOWED_TARGET_CONTRACTS=

# Required for production sponsored-fee controls.
# Expected values: positive integer/decimal strings interpreted by the relayer.
SMART_ACCOUNT_MAX_SPONSORED_FEE_PER_TX=
SMART_ACCOUNT_MAX_SPONSORED_FEE_PER_ACCOUNT_DAILY=
SMART_ACCOUNT_RELAY_RATE_LIMIT_PER_MINUTE=
